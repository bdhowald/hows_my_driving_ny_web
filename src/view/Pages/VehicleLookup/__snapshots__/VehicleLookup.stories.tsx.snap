exports[`Pages/VehicleLookup OneLookupEachFromLocalLookupAndSharedLookupOldStyleDisplay smoke-test 1`] = `
<div class="site-container-wrapper">
  <div class="site-container container-fluid">
    <main>
      <div class="row">
        <div class="site-container-wrapper">
          <div class="site-container container-fluid">
            <main>
              <div class="row">
                <div class="col-md-12 vehicle-lookup-content-container ">
                  <div class="jumbotron ">
                    <h1 class="display-4">
                      How's My Driving NY
                    </h1>
                    <p class="lead">
                      Search New York City
                      <a class="open-data-link"
                         href="https://data.cityofnewyork.us/browse?q=parking%20violations&amp;sortBy=relevance"
                         target="_blank"
                         rel="noopener noreferrer"
                      >
                        parking &amp; camera violations
                      </a>
                    </p>
                    <hr class="opacity-25">
                    <div class="row">
                      <form class="form">
                        <div class="row form-row">
                          <div class="col-md">
                            <div class="form-group">
                              <input autocomplete="off"
                                     class="form-control"
                                     id="plate-input"
                                     name="plateId"
                                     pattern="[a-zA-Z0-9]+"
                                     placeholder="Enter a plate..."
                                     type="text"
                                     value
                              >
                            </div>
                          </div>
                          <div class="col-md">
                            <div class="form-group">
                              <select aria-label="Select Region"
                                      name="state"
                                      class="form-select"
                              >
                                <optgroup label="Region">
                                  <option value="99">
                                    99 (99)
                                  </option>
                                  <option value="AB">
                                    Alberta (AB)
                                  </option>
                                  <option value="AK">
                                    Alaska (AK)
                                  </option>
                                  <option value="AL">
                                    Alabama (AL)
                                  </option>
                                  <option value="AR">
                                    Arkansas (AR)
                                  </option>
                                  <option value="AZ">
                                    Arizona (AZ)
                                  </option>
                                  <option value="BC">
                                    British Columbia (BC)
                                  </option>
                                  <option value="CA">
                                    California (CA)
                                  </option>
                                  <option value="CO">
                                    Colorado (CO)
                                  </option>
                                  <option value="CT">
