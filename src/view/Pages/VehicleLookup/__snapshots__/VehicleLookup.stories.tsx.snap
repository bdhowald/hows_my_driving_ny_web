exports[`Pages/VehicleLookup OneLookupFromCookiesNewStyleDisplay smoke-test 1`] = `
<div class="site-container-wrapper">
  <div class="site-container container-fluid">
    <main>
      <div class="row">
        <div class="site-container-wrapper">
          <div class="site-container container-fluid">
            <main>
              <div class="row">
                <div class="col-md-12 vehicle-lookup-content-container new-style">
                  <div class="jumbotron new-style">
                    <h1 class="display-4">
                      How's My Driving NY
                    </h1>
                    <p class="lead">
                      Search New York City
                      <a class="open-data-link"
                         href="https://data.cityofnewyork.us/browse?q=parking%20violations&amp;sortBy=relevance"
