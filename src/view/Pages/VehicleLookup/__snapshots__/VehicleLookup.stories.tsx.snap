                    <div class="row">
                      <form class="form">
                        <div class="row form-row">
                          <div class="col-md">
                            <div class="form-group">
                              <input autocomplete="off"
                                     class="form-control"
                                     id="plate-input"
                                     name="plateId"
                                     pattern="[a-zA-Z0-9]+"
                                     placeholder="Enter a plate..."
                                     type="text"
                                     value
                              >
                            </div>
                          </div>
                          <div class="col-md">
